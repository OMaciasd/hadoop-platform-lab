<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  hdfs-site.xml — hadoop-platform-lab
  2 DataNodes -> dfs.replication=2 (se puede practicar caída de un nodo).
  Los directorios corresponden a bind mounts bajo ./data (ver compose.yaml).
-->
<configuration>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///hadoop/dfs/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///hadoop/dfs/data</value>
  </property>
  <property>
    <name>dfs.replication</name>
    <value>2</value>
  </property>

  <!-- Direcciones de red (0.0.0.0 dentro del contenedor) -->
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>namenode:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value>0.0.0.0:9870</value>
  </property>
  <property>
    <name>dfs.datanode.address</name>
    <value>0.0.0.0:9866</value>
  </property>
  <property>
    <name>dfs.datanode.http.address</name>
    <value>0.0.0.0:9864</value>
  </property>
  <property>
    <name>dfs.datanode.ipc.address</name>
    <value>0.0.0.0:9867</value>
  </property>

  <!-- Nombres de servicio estables: el NameNode publica datanode1/datanode2 -->
  <property>
    <name>dfs.datanode.use.datanode.hostname</name>
    <value>false</value>
  </property>
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>

  <property>
    <name>dfs.namenode.handler.count</name>
    <value>10</value>
  </property>

  <!--
    Detección de fallos acelerada para el laboratorio: con los valores por
    defecto el NameNode tarda ~10 min en marcar muerto a un DataNode caído.
  -->
  <property>
    <name>dfs.heartbeat.interval</name>
    <value>5</value>
  </property>
  <property>
    <name>dfs.namenode.heartbeat.recheck-interval</name>
    <value>30000</value>
  </property>
  <property>
    <name>dfs.namenode.stale.datanode.interval</name>
    <value>15000</value>
  </property>
  <property>
    <name>dfs.webhdfs.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.client.read.shortcircuit</name>
    <value>false</value>
  </property>
  <!--
    Laboratorio: permisos desactivados para concentrarse en operación.
    Para practicar ACLs/permisos pon true (ver docs/operations.md §incidentes).
  -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>
</configuration>

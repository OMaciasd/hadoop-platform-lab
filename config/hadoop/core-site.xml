<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  core-site.xml — hadoop-platform-lab
  Punto de entrada del filesystem distribuido. fs.defaultFS apunta al
  NameNode por nombre de servicio dentro de la red propia hadoop_lab.
-->
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode:8020</value>
  </property>
  <property>
    <name>hadoop.tmp.dir</name>
    <value>/hadoop/tmp</value>
  </property>
  <property>
    <name>io.file.buffer.size</name>
    <value>131072</value>
  </property>
  <!-- Laboratorio: proxy amplio para WebHDFS desde el cliente -->
  <property>
    <name>hadoop.proxyuser.hadoop.hosts</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hadoop.groups</name>
    <value>*</value>
  </property>
  <!-- Sin Kerberos en el lab (ver docs/troubleshooting.md §seguridad) -->
  <property>
    <name>hadoop.security.authentication</name>
    <value>simple</value>
  </property>
</configuration>

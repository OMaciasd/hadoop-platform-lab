# hadoop-platform-lab — variables de entorno (copia a .env)
#
# .env está en .gitignore: aquí sólo van valores no sensibles.
# No hay secretos reales en este laboratorio (auth simple, sin Kerberos).

# Identificador de clúster HDFS (se usa sólo en el primer formato)
HADOOP_CLUSTER_ID=hadoop-platform-lab-001

# Zona horaria de los contenedores
TZ=UTC

# Versiones fijadas para reproducibilidad
HADOOP_IMAGE=apache/hadoop:3.4.3
SPARK_VERSION=3.5.3
